{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "Schedule": {
    "Interval": "00:30:00",
    "RunOnce": false
  },

  "Mailbox": {
    "Protocol": "Imap",
    "Host": "",
    "Port": 993,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "Folder": "INBOX",
    "ProcessedFolder": "Processed",
    "OnlyUnseen": true,
    "DeleteAfterProcessing": false,
    "Timeout": "00:01:00"
  },

  "Filter": {
    "FromContains": "",
    "SubjectContains": "",
    "AttachmentPattern": "*.pdf"
  },

  "Pdf": {
    "Engine": "PdfSharp",
    "QpdfPath": "qpdf",
    "Password": ""
  },

  "Naming": {
    "PathTemplate": "/{year}/{period} Payslip.pdf",
    "PeriodOffsetMonths": 0
  },

  "Archive": {
    "Provider": "Dropbox",
    "Directory": ""
  },

  "Dropbox": {
    "AppKey": "",
    "AppSecret": "",
    "RefreshToken": "",
    "RootPath": "/",
    "MuteNotifications": true
  },

  "Ledger": {
    "Path": "data/ledger.db"
  },

  "Pipeline": {
    "MaxMessagesPerCycle": 50,
    "MaxAttempts": 5
  },

  "Heartbeat": {
    "PingUrl": ""
  }
}
