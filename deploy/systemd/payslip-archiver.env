# /etc/payslip-archiver/env — loaded by the systemd unit (chmod 600).
# Every key maps onto appsettings.json with "__" as the section separator.

# --- Grimoire: every other setting and secret is read from here at startup (README → Grimoire) ---
Grimoire__BaseUrl=https://api.grimoire.straccini.com
Grimoire__ApiKey=
Grimoire__Environment=production

# Any other key set in this file overrides the Grimoire value, e.g. for a one-off change on the host:
# Schedule__Interval=00:05:00
#
# Without Grimoire (Grimoire__BaseUrl empty) set everything here instead:
# Mailbox__Host=mail.example.com
# Mailbox__Username=payslips@example.com
# Mailbox__Password=
# Filter__FromContains=@payroll-provider.example
# Filter__SubjectContains=payslip
# Pdf__Password=
# Dropbox__AppKey=
# Dropbox__RefreshToken=
# Heartbeat__PingUrl=