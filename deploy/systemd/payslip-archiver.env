# /etc/payslip-archiver/env — loaded by the systemd unit (chmod 600).
# Every key maps onto appsettings.json with "__" as the section separator.

# --- Mailbox (IMAP over TLS by default) ---
Mailbox__Protocol=Imap
Mailbox__Host=mail.example.com
Mailbox__Port=993
Mailbox__UseSsl=true
Mailbox__Username=payslips@example.com
Mailbox__Password=
Mailbox__Folder=INBOX
Mailbox__ProcessedFolder=Processed

# --- What counts as a payslip e-mail ---
Filter__FromContains=@payroll-provider.example
Filter__SubjectContains=payslip
Filter__AttachmentPattern=*.pdf

# --- The PDF password the provider uses ---
Pdf__Password=

# --- Where the clean copies go ---
Archive__Provider=Dropbox
Dropbox__AppKey=
Dropbox__RefreshToken=
Dropbox__RootPath=/

# --- Naming inside the archive ---
Naming__PathTemplate=/{year}/{period} Payslip.pdf
Naming__PeriodOffsetMonths=0

# --- Schedule & monitoring ---
Schedule__Interval=00:30:00
Heartbeat__PingUrl=
